{
	// PHP CodeSniffer (obliviousharmony.vscode-php-codesniffer) — enforce WPCS via phpcs.xml.dist
	"phpcs.enable": true,
	"phpcs.standard": "./phpcs.xml.dist",
	"phpcs.executablePath": "./vendor/bin/phpcs",
	"phpcbf.executablePath": "./vendor/bin/phpcbf",

	// Format on save: PHP -> phpcbf (WPCS auto-fix)
	"[php]": {
		"editor.defaultFormatter": "obliviousharmony.vscode-php-codesniffer",
		"editor.formatOnSave": true,
		"editor.tabSize": 4,
	},

	// Format on save: JS/TS -> ESLint (@wordpress/eslint-plugin, flat config)
	"eslint.useFlatConfig": true,
	"eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact"],
	"[javascript]": {
		"editor.defaultFormatter": "dbaeumer.vscode-eslint",
		"editor.formatOnSave": true,
		"editor.codeActionsOnSave": {
			"source.fixAll.eslint": "explicit"
		}
	},
	"[javascriptreact]": {
		"editor.defaultFormatter": "dbaeumer.vscode-eslint",
		"editor.formatOnSave": true,
		"editor.codeActionsOnSave": {
			"source.fixAll.eslint": "explicit"
		}
	},
	"[typescript]": {
		"editor.defaultFormatter": "dbaeumer.vscode-eslint",
		"editor.formatOnSave": true,
		"editor.codeActionsOnSave": {
			"source.fixAll.eslint": "explicit"
		}
	},
	"[typescriptreact]": {
		"editor.defaultFormatter": "dbaeumer.vscode-eslint",
		"editor.formatOnSave": true,
		"editor.codeActionsOnSave": {
			"source.fixAll.eslint": "explicit"
		}
	},

	// Format on save: CSS/SCSS -> Stylelint
	"stylelint.validate": ["css", "scss"],
	"[css]": {
		"editor.defaultFormatter": "stylelint.vscode-stylelint",
		"editor.formatOnSave": true,
		"editor.codeActionsOnSave": {
			"source.fixAll.stylelint": "explicit"
		}
	},
	"[scss]": {
		"editor.defaultFormatter": "stylelint.vscode-stylelint",
		"editor.formatOnSave": true,
		"editor.codeActionsOnSave": {
			"source.fixAll.stylelint": "explicit"
		}
	},

	// Editor hygiene matching .editorconfig
	"editor.tabSize": 2,
	"editor.insertSpaces": false,
	"files.eol": "\n",
	"files.insertFinalNewline": true,
	"files.trimTrailingWhitespace": true,

	// Performance: exclude build/vendor/node_modules
	"files.watcherExclude": {
		"**/vendor/**": true,
		"**/node_modules/**": true,
		"**/build/**": true
	},
	"search.exclude": {
		"**/vendor": true,
		"**/node_modules": true,
		"**/build": true
	}
}
